# ============================================================
# CMPIS melanoma pipeline — ignore rules
# Rule of thumb: version code + small curated inputs + docs.
# Everything large or regenerable is downloaded/rebuilt by the
# pipeline (see README + data/README.md), never committed.
# ============================================================

# --- R / RStudio session cruft ---
.Rproj.user/
.Rhistory
.Rapp.history
.RData
.RDataTmp
*.RData
*.rdb
*.rdx
.Ruserdata

# --- renv: keep lockfile + activate script, ignore the library ---
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/

# --- Raw downloads (regenerated by the download scripts) ---
GDCdata/
geo_data/
MANIFEST.txt

# --- Large intermediate / derived data (regenerable) ---
scaled_expression_data.csv
TCGA_SKCM_gene_expression_counts.csv
de.csv
expr_est_raw.txt
expr_est_input.gct

# --- Large EXTERNAL inputs (download separately; see data/README.md) ---
Expression_Public_25Q3_subsetted.csv

# --- Vendored R package tarballs (install via renv / setup script) ---
*.tar.gz

# --- Very large figure PDFs (regenerate from the pipeline) ---
COCA Heatmap.pdf
COMPREHENSIVE HEATMAP*.pdf
MoCluster Heatmap.pdf
NEMO CLUSTERING.pdf
UPREGULATED BIOMARKER HEATMAP*.pdf

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Large external input matrices (download; see data/README.md) ---
GSE98394_expression.txt

# --- Generated MOVICS / analysis output directories ---
1-1-SKCM_MPCDS-*/
1-GSEA-result/
skcm_analysis_results/
setup_repo.ps1
run_cmpis_setup.bat

# --- {targets} pipeline store ---
_targets/
